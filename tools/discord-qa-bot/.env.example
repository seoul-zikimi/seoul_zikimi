# 디스코드 개발자 포털 > Bot > Token
DISCORD_TOKEN=여기에_봇_토큰

# QA 포럼 채널 ID (디스코드 개발자 모드 켜고 채널 우클릭 > ID 복사)
QA_FORUM_CHANNEL_ID=여기에_채널_ID

# 수정 대상 레포 경로
REPO_ROOT=C:\Users\Dev\Desktop\seoul_zikimi

# claude CLI 명령어 (PATH에 있으면 그대로)
CLAUDE_CMD=claude

# --- 아래는 선택 (기본값 있음) ---
# 봇 전용 작업 폴더 (git worktree). 기본: 레포 옆에 <레포명>-qa-workspace
# BOT_WORKSPACE=C:\Users\Dev\Desktop\seoul_zikimi-qa-workspace
# GIT_REMOTE=origin
# MAIN_BRANCH=main
# 수정 후 PR 자동 생성 여부 (gh CLI 로그인 필요)
# CREATE_PR=true

# 토큰 리포트: 매일 자동 보고를 올릴 채널 ID (안 넣으면 /tokenusage 명령어만 동작)
# TOKEN_REPORT_CHANNEL_ID=여기에_채널_ID
# 자동 보고 시각 (기본 10 = 오전 10시 이후 봇이 켜져 있을 때 하루 1회)
# TOKEN_REPORT_HOUR=10
